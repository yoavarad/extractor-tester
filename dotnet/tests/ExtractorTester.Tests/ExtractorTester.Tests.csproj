<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ExtractorTester/ExtractorTester.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Fixtures/seqmatcher_cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**/*.json;Fixtures/**/*.jsonl;Fixtures/**/*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Golden corpus (task 140): inputs exported by tests/golden/corpus.py (dotnet export); expected outputs,
       metrics.md and tool-error manifests are linked from the Python side so there is one source. -->
  <ItemGroup>
    <None Include="../golden/input/**" Link="Golden/input/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../tests/golden/expected/*" Link="Golden/expected/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../docs/specs/metrics.md" Link="Golden/metrics.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../.ydk/components/tool-error/errors/*.yaml" Link="Golden/tool-errors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../.ydk/components/entity/model/*.yaml" Link="Manifests/model/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
